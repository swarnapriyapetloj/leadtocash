<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Salesforce Lead-to-Cash Suite" verbose="1">

    <listeners>
        <listener class-name="com.salesforce.l2c.listeners.ExtentReportListener"/>
    </listeners>

    <test name="L2C Regression">
        <classes>
            <class name="com.salesforce.l2c.tests.LoginTest"/>
            <class name="com.salesforce.l2c.tests.LeadToCashTest"/>
        </classes>
    </test>
</suite>
